{
	"name": "@sailpoint/ui-plugin-sdk",
	"version": "0.0.0",
	"description": "Browser runtime library for SailPoint ISC UI plugins",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/sailpoint-oss/ui-plugin-sdk.git"
	},
	"homepage": "https://github.com/sailpoint-oss/ui-plugin-sdk#readme",
	"bugs": {
		"url": "https://github.com/sailpoint-oss/ui-plugin-sdk/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@10.17.1",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"minimumReleaseAge": 1440
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"lint": "eslint 'src/**/*.ts' '__tests__/**/*.ts'",
		"lint:fix": "eslint --fix 'src/**/*.ts' '__tests__/**/*.ts'",
		"format": "prettier --write 'src/**/*.ts' '__tests__/**/*.ts'",
		"format:check": "prettier --check 'src/**/*.ts' '__tests__/**/*.ts'",
		"test": "jest",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/jest": "^29.5.14",
		"@typescript-eslint/eslint-plugin": "^8.32.1",
		"@typescript-eslint/parser": "^8.32.1",
		"eslint": "^9.27.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-jest": "^29.15.3",
		"eslint-plugin-prettier": "^5.4.0",
		"globals": "^16.1.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"prettier": "^3.5.3",
		"ts-jest": "^29.3.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	}
}
